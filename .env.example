APP_NAME="SEFAL"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Bahia

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Seletor de banco: oracle | sqlite | auto
#   oracle -> Oracle real (exige extensão oci8 + Oracle Instant Client + rede/credenciais)
#   sqlite -> database/fiscalizacao_dev.sqlite (dev offline, sem oci8)
#   auto   -> Oracle quando houver oci8 E DB_HOST preenchido; senão SQLite
DB_DRIVER=auto
DB_CONNECTION=sqlite

# Oracle (preencher só quando DB_DRIVER=oracle ou auto com acesso ao banco)
DB_HOST=
DB_PORT=1521
DB_DATABASE=
DB_SERVICE_NAME=
DB_USERNAME=
DB_PASSWORD=
DB_PREFIX=LRV_

# Controle de acesso (Modo Gerente): off = não confere; log = registra quem seria
# barrado, sem barrar; block = barra de verdade. Padrão `block` — tela nova
# precisa de concessão na matriz, senão ninguém a abre. A tela do próprio Modo
# Gerente barra em qualquer modo. `off`/`log` são só para diagnóstico pontual.
PERMISSAO_ENFORCE=block

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Integração com o e-Salvador ────────────────────────────────────────────
# O e-Salvador é o sistema de PROCESSO ADMINISTRATIVO da Prefeitura (SEMGE). Não
# existe recurso "denúncia" na API dele: a denúncia chega como PROCESSO, e é a
# classificação (grupo → assunto → subassunto) que diz que ela é nossa.
# Estudo do contrato: docs/integracoes/esalvador.md
#
# ⚠️ A SEMGE cadastra o IP da aplicação junto com as credenciais. A documentação
# não diz se chamada de IP não cadastrado é recusada — teste e anote no doc.

ESALVADOR_LIGADA=false
ESALVADOR_URL=https://apiesalvador.salvador.ba.gov.br/api

# Entregues pela equipe do e-Salvador (SEMGE), junto com a liberação de IP.
ESALVADOR_NOME=
ESALVADOR_PASSWORD=
# Gerado por uma PESSOA dentro do e-Salvador: Ajuda → Integração Token.
# Não expira, e não fica guardado lá — perdeu, gera outro e o antigo morre.
ESALVADOR_TOKEN=

# A caixa da SEMOP que recebe as denúncias. Descobertos e confirmados com dado
# real em 15/09/2026: SEMOP = órgão 5369; SEFAL (Setor de Fiscalização de
# Atividades em Logradouros Públicos) = unidade 5382.
ESALVADOR_UNIDADE=5382
ESALVADOR_ORGAO=5369

# O que, no catálogo do e-Salvador, é denúncia nossa. Listas separadas por
# vírgula. Vazio = a integração não reconhece nada — que é o certo enquanto
# ninguém confirmou os códigos. Descubra com GET /grupos e GET /assuntos/{grupo}.
# Grupo 10 = ORDEM PUBLICA. Assunto 215 = COMERCIO INFORMAL E ESPACO PUBLICO -
# FISCALIZACAO, que e' o que de fato chega a' caixa da SEFAL (38 processos em 89
# dias). Candidatos vizinhos, a confirmar com a SEMOP: 222 (cadastro), 223
# (outros), 216..221 (licencas, o canal "nova licenca").
# ⚠️ NAO use 235 (OUVIDORIA/DENUNCIA): e' a ouvidoria da cidade inteira — os
# processos que aparecem la' sao de outras secretarias.
# Subassuntos: nenhum dos nossos assuntos tem — a classificacao e' de 2 niveis.
ESALVADOR_GRUPOS=10
ESALVADOR_ASSUNTOS=215
ESALVADOR_SUBASSUNTOS=
