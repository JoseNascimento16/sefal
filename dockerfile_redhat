# SEFAL no OKD do cliente (COGEL) — formato S2I, 1 container (Apache + mod_php na 8080).
#
# Copiado da estrutura já provada no CODECON (ver a skill `deploy-gitlab-okd` e
# `docs/deploy/okd-deploy.md` no ferramental), com o que é DESTE projeto e sem o
# que é do outro:
#
#   • oci8 + Oracle Instant Client — ENTRA: a produção do SEFAL é Oracle, e o
#     `composer.json` fixa `ext-oci8` na plataforma.
#   • LibreOffice — FICA FORA: são ~800 MB para converter Office→PDF, coisa do
#     CODECON. O SEFAL gera PDF/XLSX/DOCX pelo motor próprio de relatórios, que
#     é PHP puro.
#
# ⚠️ A base (`FROM`) é a imagem que o DevOps do cliente mantém DENTRO do cluster
# (UBI + PHP 8.4 + Node + scripts S2I). Troque `<NAMESPACE>` pelo namespace do
# projeto do SEFAL no OKD — a tag precisa existir lá; se o Alan ainda não a
# publicou nesse namespace, é ele quem republica ou libera o acesso.
FROM image-registry.openshift-image-registry.svc:5000/<NAMESPACE>/php:latest

# Instala pacotes como root; em runtime a imagem volta a rodar como 1001 (o Pod
# Security do cluster é `restricted`, e nada roda como root lá).
USER 0
ADD . /tmp/src
RUN chown -R 1001:0 /tmp/src

# ── Oracle: oci8 + Instant Client ───────────────────────────────────────────
# Sem isto o app sobe e morre na primeira consulta: a conexão de produção é
# Oracle (schema próprio LRV_ do SEFAL, usuário USR_SEFAL).
RUN yum install -y php-pear php-devel && \
    yum install -y https://download.oracle.com/otn_software/linux/instantclient/2350000/oracle-instantclient-basic-23.5.0.24.07-1.el9.x86_64.rpm && \
    yum install -y https://download.oracle.com/otn_software/linux/instantclient/2350000/oracle-instantclient-devel-23.5.0.24.07-1.el9.x86_64.rpm && \
    rm -f *.rpm && yum clean all
RUN pecl install oci8
RUN echo "extension=oci8.so" > /etc/php.d/50-oci8.ini

# ── Limites do PHP ──────────────────────────────────────────────────────────
# Gravados no conf.d da imagem, e não como variável de ambiente no Deployment:
# a base é customizada e não há garantia de que ela honre as `PHP_*` do S2I —
# um rollout "verde" poderia não mudar limite nenhum. No CODECON esse foi um
# defeito real: o anexo grande falhava SÓ em homologação, porque o pod herdava
# os defaults (upload 2M / post 8M). O SEFAL recebe FOTO de fiscalização, então
# o limite importa aqui pelo mesmo motivo.
RUN { \
        echo 'upload_max_filesize = 20M'; \
        echo 'post_max_size = 48M'; \
        echo 'memory_limit = 256M'; \
        echo 'max_file_uploads = 30'; \
        echo 'display_errors = Off'; \
        echo 'log_errors = On'; \
    } > /etc/php.d/zz-sefal.ini

USER 1001

# `assemble` do S2I = composer install. Depois os assets do Vite.
RUN /usr/libexec/s2i/assemble

# ⚠️ O `npm run build` do SEFAL BOOTA a aplicação (o plugin do Wayfinder chama
# `php artisan wayfinder:generate`), e no build não existe banco nem APP_KEY.
# Por isso o .env descartável e o `DB_DRIVER=sqlite`: sem eles o build morre no
# timeout de conexão do Oracle — e o erro não parece de build, parece de rede.
# O arquivo é apagado no fim: o .env que vale em runtime é o Secret montado pelo
# Deployment.
RUN cp .env.example .env \
    && php artisan key:generate --force --no-interaction --no-ansi \
    && DB_DRIVER=sqlite php artisan wayfinder:generate --with-form --no-ansi \
    && npm ci \
    && DB_DRIVER=sqlite npm run build \
    && rm -f .env

# Carimbo de versão para o rodapé: `getenv OPENSHIFT_BUILD_*` não chega ao
# contexto web, então a hora do build fica gravada em arquivo.
RUN date -u -d '3 hours ago' +'v-%Y%m%d%H%M' > /opt/app-root/src/version.txt

# Sobe Apache + PHP na 8080. O `DOCUMENTROOT=/public` vem do Deployment — sem
# ele o Apache serve a raiz do repositório e o `.env` fica exposto na web.
CMD /usr/libexec/s2i/run
